# Explicit provider: deepseek, compatible, or coze. No key enables manual selection.
MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
MODEL_API_KEY=
# DeepSeek also accepts an existing DEEPSEEK_API_KEY environment variable.
# Coze credentials are used only when explicitly selected, or in legacy auto mode.
COZE_BASE_URL=https://api.coze.cn
COZE_API_KEY=
COZE_BOT_ID=
PORT=5174
