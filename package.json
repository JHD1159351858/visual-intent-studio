{
  "name": "visual-intent-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-next.mjs dev",
    "build": "next build && node scripts/package-standalone.mjs",
    "start": "node scripts/start-next.mjs start",
    "test": "vitest run",
    "record:demos": "node scripts/record-demos.mjs",
    "capture:previews": "node scripts/capture-sources.mjs --concurrency=1",
    "fill:catalog": "tsx scripts/populate-catalog.ts",
    "test:e2e": "node scripts/check-next-standalone.mjs",
    "evaluate:model": "tsx scripts/evaluate-model.ts",
    "export:design-knowledge": "tsx scripts/export-design-knowledge.ts",
    "export:case-knowledge": "tsx scripts/export-case-knowledge.ts",
    "verify:design-library": "node scripts/verify-design-library.mjs",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "latest",
    "dotenv": "latest",
    "lucide-react": "latest",
    "next": "16.4.3",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "playwright": "latest",
    "tsx": "latest",
    "typescript": "~5.9.3",
    "vitest": "latest"
  }
}
